{
    "name": "ucac-icam/calculator-workshop",
    "description": "Workshop Tests et Qualité Logicielle - Calculator",
    "require": { "php": ">=8.1" },
    "require-dev": { "phpunit/phpunit": "^10.5" },
    "autoload": { "psr-4": { "App\\": "src/" } },
    "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
    "scripts": {
        "test": "phpunit",
        "coverage": "XDEBUG_MODE=coverage phpunit --coverage-html coverage --coverage-clover coverage/clover.xml --log-junit coverage/junit.xml"
    }
}
